# Required for local development and Prisma commands
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velora?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: rate limiting and dashboard caching. Defaults to localhost Redis.
REDIS_URL="redis://localhost:6379"

# Self-hosted only: header your reverse proxy overwrites with the client IP.
# Vercel uses its platform-provided X-Forwarded-For header automatically.
TRUSTED_CLIENT_IP_HEADER=""

# Optional: Google OAuth login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: SMTP email delivery (verification, password reset, order updates)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Velora <noreply@example.com>"

# Legacy SMTP aliases; used only when SMTP_USER / SMTP_PASSWORD are unset
AUTH_EMAIL_USER=""
AUTH_EMAIL_PASSWORD=""

# Optional: admin product image uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: PayHere checkout and payment notifications
PAYHERE_SANDBOX="true"
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_NOTIFY_URL="https://your-public-host/api/payments/payhere/notify"
